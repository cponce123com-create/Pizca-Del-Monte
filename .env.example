# ============================================
# PIZCA DEL MONTE - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
# ============================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL - Neon Free Tier)
# -----------------------------------------------------------------------------
# Format: postgresql://user:password@host:port/database?sslmode=require
# Sin DATABASE_URL la tienda muestra automáticamente el catálogo demo.
# Para forzar la demostración aunque exista una base, usar DEMO_MODE=true.
DEMO_MODE=true
DATABASE_URL=""

# For Prisma migrations (can be same as DATABASE_URL)
# Use a connection pooler for better performance in serverless
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/pizca_del_monte?sslmode=require"

# -----------------------------------------------------------------------------
# AUTHENTICATION (NextAuth.js)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (optional)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# EMAIL (SMTP - for transactional emails)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Pizca del Monte <noreply@pizcadelmonte.pe>"

# Alternative: Resend (recommended for serverless)
# RESEND_API_KEY="re_xxxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# PAYMENTS - MERCADO PAGO (Peru)
# -----------------------------------------------------------------------------
# Get credentials from: https://www.mercadopago.com.pe/developers/panel
MERCADOPAGO_PUBLIC_KEY="TEST-xxxxxxxxxxxxx"
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxxxxxxx"
MERCADOPAGO_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxx"

# Mercado Pago Webhook URL (production)
# MERCADOPAGO_WEBHOOK_URL=https://pizcadelmonte.pe/api/webhooks/mercadopago

# -----------------------------------------------------------------------------
# PAYMENTS - YAPE / PLIN (Peru Mobile Payments)
# -----------------------------------------------------------------------------
# Yape/Plin integration typically via payment gateway (Mercado Pago, Culqi, etc.)
# Or direct integration with bank APIs
YAPE_MERCHANT_ID=""
YAPE_API_KEY=""
PLIN_MERCHANT_ID=""
PLIN_API_KEY=""

# -----------------------------------------------------------------------------
# PAYMENTS - BANK TRANSFER (Manual verification)
# -----------------------------------------------------------------------------
BANK_TRANSFER_ENABLED=false
BANK_ACCOUNT_INFO=""

# -----------------------------------------------------------------------------
# SHIPPING - SHALOM (Primary carrier for Peru)
# -----------------------------------------------------------------------------
# Get API credentials from Shalom
SHALOM_API_KEY=""
SHALOM_API_SECRET=""
SHALOM_CLIENT_ID=""
SHALOM_BASE_URL=https://api.shalom.com.pe/v1
SHALOM_TEST_MODE=true

# Shalom Webhook
SHALOM_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# SHIPPING - OLVA COURIER (Alternative)
# -----------------------------------------------------------------------------
OLVA_API_KEY=""
OLVA_API_SECRET=""

# -----------------------------------------------------------------------------
# SHIPPING - SERPOST (Correos del Perú)
# -----------------------------------------------------------------------------
SERPOST_API_KEY=""
SERPOST_API_SECRET=""

# -----------------------------------------------------------------------------
# INVOICING - SUNAT (Peru Electronic Invoicing)
# -----------------------------------------------------------------------------
# For production, use a certified PSE (Proveedor de Servicios Electrónicos)
# like: NubeFact, Factura.pe, E-Fact, etc.
SUNAT_RUC="20123456789"
SUNAT_USERNAME=""
SUNAT_PASSWORD=""
SUNAT_ENDPOINT=https://api.sunat.gob.pe/v1  # Production
# SUNAT_ENDPOINT=https://api-test.sunat.gob.pe/v1  # Beta/Testing

# PSE Provider (e.g., NubeFact)
PSE_PROVIDER=nubefact
PSE_API_KEY=""
PSE_BASE_URL=https://api.nubefact.com/api/v1
# NubeFact Webhook Secret for verifying webhook signatures
NUBEFACT_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# CLOUDINARY (Image Management)
# -----------------------------------------------------------------------------
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_UPLOAD_PRESET="pizca-products"

# Cloudinary URL format (alternative)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# -----------------------------------------------------------------------------
# REDIS / UPSTASH (Caching, Rate Limiting, Sessions)
# -----------------------------------------------------------------------------
# Get from: https://upstash.com/
# Required in production for login and registration rate limiting. The app fails
# closed for those flows if the REST URL/token are absent or Redis is unavailable.
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN="your-token"

# Reserved for TCP-based Redis integrations; auth rate limiting currently uses Upstash REST.
# REDIS_URL=redis://user:pass@host:port

# -----------------------------------------------------------------------------
# SEARCH - ALGOLIA (Product Search)
# -----------------------------------------------------------------------------
ALGOLIA_APP_ID=""
ALGOLIA_API_KEY=""
ALGOLIA_SEARCH_KEY=""
ALGOLIA_INDEX_NAME="products"

# -----------------------------------------------------------------------------
# ANALYTICS & TRACKING
# -----------------------------------------------------------------------------
# Google Analytics 4
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Tag Manager
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Facebook/Meta Pixel
NEXT_PUBLIC_FB_PIXEL_ID=""

# TikTok Pixel
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# Hotjar
NEXT_PUBLIC_HOTJAR_ID=""

# -----------------------------------------------------------------------------
# ERROR TRACKING - SENTRY
# -----------------------------------------------------------------------------
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_WISHLIST=true
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_ENABLE_RECIPES=true
NEXT_PUBLIC_ENABLE_BUNDLES=true
NEXT_PUBLIC_ENABLE_GIFT_CARDS=true
NEXT_PUBLIC_ENABLE_WHOLESALE=true
NEXT_PUBLIC_ENABLE_LOYALTY=false

# -----------------------------------------------------------------------------
# STORE SETTINGS (Overridden by database settings)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME="Pizca del Monte"
NEXT_PUBLIC_STORE_CURRENCY=PEN
NEXT_PUBLIC_STORE_LOCALE=es-PE
NEXT_PUBLIC_DEFAULT_SHIPPING_CARRIER=shalom
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=

# -----------------------------------------------------------------------------
# FILE UPLOADS
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/avif,application/pdf

# -----------------------------------------------------------------------------
# CRON JOBS / SCHEDULED TASKS
# -----------------------------------------------------------------------------
# Cron secret for protecting endpoints
CRON_SECRET="your-cron-secret-key"

# -----------------------------------------------------------------------------
# DEVELOPMENT TOOLS
# -----------------------------------------------------------------------------
# Prisma Studio
# PRISMA_STUDIO_PORT=5555

# Email testing (development)
# EMAIL_TEST_MODE=true
# ETHEREAL_EMAIL_USER=""
# ETHEREAL_EMAIL_PASS=""

# -----------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS
# -----------------------------------------------------------------------------
# WhatsApp Business API (for notifications)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Google Maps (for address autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# -----------------------------------------------------------------------------
# INTERNATIONALIZATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_LOCALE=es-PE
NEXT_PUBLIC_SUPPORTED_LOCALES=es-PE,en-US
NEXT_PUBLIC_DEFAULT_CURRENCY=PEN
NEXT_PUBLIC_SUPPORTED_CURRENCIES=PEN,USD

# -----------------------------------------------------------------------------
# SEO
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Pizca del Monte"
NEXT_PUBLIC_DEFAULT_OG_IMAGE=/images/og-default.jpg
# Administrador separado: secreto distinto de AUTH_SECRET/NEXTAUTH_SECRET (mínimo 32 caracteres).
# Configúralo solo en el servicio del administrador, junto con una base propia del entorno.
ADMIN_AUTH_SECRET=
# Credenciales elegidas por el operador; se usan únicamente al inicializar el superadmin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
