{
  "name": "pizca-del-monte",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:admin\"",
    "dev:web": "pnpm --filter @pizca/web dev",
    "dev:admin": "pnpm --filter @pizca/admin dev",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @pizca/web build",
    "build:admin": "pnpm --filter @pizca/admin build",
    "lint": "pnpm -r --if-present lint",
    "type-check": "pnpm -r --if-present type-check",
    "db:generate": "pnpm --filter @pizca/database db:generate",
    "db:push": "pnpm --filter @pizca/database db:push",
    "db:migrate": "pnpm --filter @pizca/database db:migrate",
    "db:seed": "pnpm --filter @pizca/database db:seed",
    "db:studio": "pnpm --filter @pizca/database db:studio",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @pizca/web test:e2e"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.2",
    "husky": "^9.0.11",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "zod": "^4.6.6"
    }
  }
}
