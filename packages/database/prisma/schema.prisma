// Pizca del Monte - Prisma Schema
// Esquema completo para tienda gourmet peruana
// Compatible con Neon Free Tier y Render Free Tier

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Configuración para Neon con pool de conexiones
  // connection_limit = 5 // Se configura via DATABASE_URL con ?connection_limit=5
}

// ============================================
// ENUMS
// ============================================

enum Role {
  SUPERADMIN
  ADMIN
  CATALOG
  WAREHOUSE
  SALES
  SUPPORT
  ACCOUNTING
}

enum Permission {
  // Usuarios y roles
  USER_CREATE
  USER_READ
  USER_UPDATE
  USER_DELETE
  ROLE_MANAGE

  // Catálogo
  PRODUCT_CREATE
  PRODUCT_READ
  PRODUCT_UPDATE
  PRODUCT_DELETE
  CATEGORY_MANAGE
  COLLECTION_MANAGE
  BRAND_MANAGE
  ATTRIBUTE_MANAGE
  MEDIA_UPLOAD

  // Precios y promociones
  PRICE_MANAGE
  PROMOTION_MANAGE
  COUPON_MANAGE
  TAX_MANAGE

  // Inventario
  INVENTORY_READ
  INVENTORY_UPDATE
  STOCK_MOVEMENT_CREATE
  LOT_MANAGE
  SUPPLIER_MANAGE
  PURCHASE_ORDER_MANAGE
  PHYSICAL_COUNT

  // Ventas
  ORDER_READ
  ORDER_UPDATE
  ORDER_CANCEL
  ORDER_REFUND
  ORDER_SHIP
  CART_MANAGE
  CHECKOUT_MANAGE
  WHOLESALE_MANAGE

  // Clientes
  CUSTOMER_READ
  CUSTOMER_UPDATE
  ADDRESS_MANAGE
  COMMUNICATION_SEND

  // Logística
  SHIPMENT_CREATE
  SHIPMENT_UPDATE
  TRACKING_MANAGE
  CARRIER_MANAGE

  // Facturación
  INVOICE_CREATE
  INVOICE_READ
  RECEIPT_CREATE
  ACCOUNTING_READ
  ACCOUNTING_WRITE
  CASH_MOVEMENT
  EXPENSE_MANAGE
  TAX_CONFIGURE

  // Etiquetas y códigos
  LABEL_TEMPLATE_MANAGE
  QR_GENERATE
  BARCODE_GENERATE
  LABEL_PRINT

  // Recetas
  RECIPE_CREATE
  RECIPE_READ
  RECIPE_UPDATE
  RECIPE_DELETE
  RECIPE_PUBLISH

  // CMS
  BANNER_MANAGE
  PAGE_MANAGE
  MENU_MANAGE
  SEO_MANAGE
  SOCIAL_MANAGE

  // Reportes
  REPORT_READ
  REPORT_EXPORT
  AUDIT_READ

  // Configuración
  SETTINGS_MANAGE
  WEBHOOK_MANAGE
  INTEGRATION_CONFIGURE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
  DISCONTINUED
}

enum ProductType {
  SIMPLE
  VARIABLE
  BUNDLE
  GIFT_CARD
  RECIPE_KIT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  PREPARING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  ON_HOLD
  DISPUTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  REFUNDED
  PARTIALLY_REFUNDED
  CHARGEBACK
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  MERCADO_PAGO
  YAPE
  PLIN
  BANK_TRANSFER
  CASH_ON_DELIVERY
  CREDIT_CARD
  DEBIT_CARD
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED
  LOST
  CANCELLED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  EXPIRED
  DAMAGED
  SAMPLE
  GIFT
  PRODUCTION
  CONSUMPTION
}

enum LotStatus {
  ACTIVE
  EXPIRED
  CONSUMED
  QUARANTINE
  RECALLED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_X_GET_Y
  GIFT_PRODUCT
}

enum PromotionType {
  PERCENTAGE_OFF
  FIXED_AMOUNT_OFF
  BUY_X_GET_Y
  FREE_SHIPPING
  GIFT_WITH_PURCHASE
  VOLUME_DISCOUNT
  TIME_LIMITED
}

enum NotificationType {
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  REFUND_PROCESSED
  LOW_STOCK
  BACK_IN_STOCK
  PRICE_DROP
  NEW_RECIPE
  PROMOTION
  NEWSLETTER
  SUPPORT_TICKET
  REVIEW_REQUEST
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum DocumentType {
  INVOICE
  RECEIPT
  CREDIT_NOTE
  DEBIT_NOTE
  DELIVERY_NOTE
  PICKING_LIST
  PACKING_LIST
  QUOTATION
  INTERNAL_RECEIPT
  CASH_RECEIPT
}

enum AccountingEntryType {
  SALE
  PURCHASE
  EXPENSE
  INCOME
  TRANSFER
  ADJUSTMENT
  DEPRECIATION
  TAX
  PAYROLL
  LOAN
}

enum CashMovementType {
  OPENING
  CLOSING
  SALE
  REFUND
  EXPENSE
  INCOME
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum TaxType {
  IGV
  ISC
  PERCEPCION
  RETENCION
  DETRACCION
}

enum WebhookEventType {
  MERCADO_PAGO_PAYMENT
  MERCADO_PAGO_MERCHANT_ORDER
  SHALOM_TRACKING
  SUNAT_DOCUMENT
  NEON_DATABASE
  CLOUDINARY_UPLOAD
}

// ============================================
// MODELOS BASE Y UTILIDADES
// ============================================

// ============================================
// IDENTIDAD, ROLES Y PERMISOS
// ============================================

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  avatar        String?
  phone         String?
  phoneVerified DateTime?
  status        UserStatus   @default(PENDING_VERIFICATION)
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret String?
  lastLoginAt   DateTime?
  loginAttempts Int          @default(0)
  lockedUntil   DateTime?
  locale        String       @default("es-PE")
  timezone      String       @default("America/Lima")
  currency      String       @default("PEN")

  // Relaciones
  roles         UserRole[]
  sessions      Session[]
  addresses     Address[]
  orders        Order[]
  cart          Cart?
  wishlist      Wishlist[]
  reviews       Review[]
  notifications Notification[]
  auditLogs     AuditLog[]
  cashMovements CashMovement[]
  accountingEntries AccountingEntry[]
  recipes       Recipe[]
  recipeRatings RecipeRating[]
  qrCodes       QrCode[]
  labels        PrintedLabel[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model RoleModel {
  id          String   @id @default(cuid())
  name        Role     @unique
  description String?
  permissions Permission[]
  isSystem    Boolean  @default(false)
  priority    Int      @default(0)

  users       UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  assignedBy String?
  assignedAt DateTime @default(now())
  expiresAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      RoleModel @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActivity DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

// ============================================
// CATÁLOGO: PRODUCTOS, CATEGORÍAS, COLECCIONES, VARIANTES
// ============================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  icon        String?
  parentId    String?
  level       Int      @default(0)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  showInMenu  Boolean  @default(true)
  seoTitle    String?
  seoDescription String?
  seoKeywords String[]

  // Relaciones
  parent      Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]   @relation("CategoryHierarchy")
  products    ProductCategory[]
  collections CollectionCategory[]
  attributes  CategoryAttribute[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive, level])
  @@map("categories")
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  logo        String?
  website     String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  products    Product[]

  @@index([slug])
  @@map("brands")
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  bannerImage String?
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  startDate   DateTime?
  endDate     DateTime?
  seoTitle    String?
  seoDescription String?
  seoKeywords String[]

  products    CollectionProduct[]
  categories  CollectionCategory[]

  @@index([slug])
  @@index([isActive, isFeatured])
  @@map("collections")
}

model Product {
  id              String       @id @default(cuid())
  sku             String       @unique
  name            String
  slug            String       @unique
  description     String?
  shortDescription String?
  type            ProductType  @default(SIMPLE)
  status          ProductStatus @default(DRAFT)
  brandId         String?
  basePrice       Decimal      @db.Decimal(12, 2)
  compareAtPrice  Decimal?     @db.Decimal(12, 2)
  costPrice       Decimal?     @db.Decimal(12, 2)
  taxRate         Decimal      @default(18.00) @db.Decimal(5, 2) // IGV 18%
  taxType         TaxType      @default(IGV)
  weight          Decimal?     @db.Decimal(8, 3) // kg
  length          Decimal?     @db.Decimal(8, 3) // cm
  width           Decimal?     @db.Decimal(8, 3) // cm
  height          Decimal?     @db.Decimal(8, 3) // cm
  unitOfMeasure   String       @default("UN") // UN, KG, G, L, ML, PAQ
  minOrderQty     Int          @default(1)
  maxOrderQty     Int?
  trackInventory  Boolean      @default(true)
  allowBackorder  Boolean      @default(false)
  requiresShipping Boolean     @default(true)
  isGiftCard      Boolean      @default(false)
  giftCardTemplateId String?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]
  publishedAt     DateTime?
  featuredUntil   DateTime?

  // Relaciones
  brand           Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categories      ProductCategory[]
  collections     CollectionProduct[]
  variants        ProductVariant[]
  media           ProductMedia[]
  attributes      ProductAttributeValue[]
  inventory       InventoryItem?
  lots            InventoryLot[]
  stockMovements  StockMovement[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  recipeIngredients RecipeIngredient[]
  recipeProducts  RecipeProduct[]
  relatedProducts ProductRelation[] @relation("ProductRelations")
  relatedTo       ProductRelation[] @relation("ProductRelatedTo")
  bundles         BundleItem[]     @relation("BundleProducts")
  bundleOf        BundleItem[]     @relation("BundleComponents")
  promotions      PromotionProduct[]
  coupons         CouponProduct[]
  wishlistItems   Wishlist[]
  reviews         Review[]
  qrCodes         QrCode[]
  labels          PrintedLabel[]
  shippingRules   ShippingRule[]

  @@index([slug])
  @@index([sku])
  @@index([status])
  @@index([brandId])
  @@index([publishedAt])
  @@map("products")
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  sku             String   @unique
  name            String
  barcode         String?  @unique
  ean13           String?  @unique
  price           Decimal  @db.Decimal(12, 2)
  compareAtPrice  Decimal? @db.Decimal(12, 2)
  costPrice       Decimal? @db.Decimal(12, 2)
  weight          Decimal? @db.Decimal(8, 3)
  length          Decimal? @db.Decimal(8, 3)
  width           Decimal? @db.Decimal(8, 3)
  height          Decimal? @db.Decimal(8, 3)
  unitOfMeasure   String   @default("UN")
  sortOrder       Int      @default(0)
  isDefault       Boolean  @default(false)
  trackInventory  Boolean  @default(true)
  allowBackorder  Boolean  @default(false)

  // Atributos que definen esta variante (ej: peso, sabor, presentación)
  attributes      ProductAttributeValue[]

  // Relaciones
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory       InventoryItem?
  lots            InventoryLot[]
  stockMovements  StockMovement[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  bundleItems     BundleItem[]
  labels          PrintedLabel[]

  @@index([productId])
  @@index([sku])
  @@index([barcode])
  @@index([ean13])
  @@map("product_variants")
}

model ProductCategory {
  id          String   @id @default(cuid())
  productId   String
  categoryId  String
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("product_categories")
}

model CollectionProduct {
  id            String      @id @default(cuid())
  collectionId  String
  productId     String
  sortOrder     Int         @default(0)
  isFeatured    Boolean     @default(false)

  collection    Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
  @@map("collection_products")
}

model CollectionCategory {
  id          String      @id @default(cuid())
  collectionId String
  categoryId  String

  collection  Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([collectionId, categoryId])
  @@map("collection_categories")
}

model Attribute {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        String   @default("select") // select, text, number, boolean, color, date
  isRequired  Boolean  @default(false)
  isFilterable Boolean @default(true)
  isVariant   Boolean  @default(false) // Define variantes del producto
  sortOrder   Int      @default(0)
  helpText    String?

  values      AttributeValue[]
  categories  CategoryAttribute[]
  products    ProductAttributeValue[]

  @@index([slug])
  @@map("attributes")
}

model AttributeValue {
  id          String     @id @default(cuid())
  attributeId String
  value       String
  slug        String
  color       String?    // Para atributos de color
  image       String?    // Para atributos visuales
  sortOrder   Int        @default(0)

  attribute   Attribute  @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products    ProductAttributeValue[]
  variants    ProductAttributeValue[]

  @@unique([attributeId, slug])
  @@index([attributeId])
  @@map("attribute_values")
}

model CategoryAttribute {
  id          String     @id @default(cuid())
  categoryId  String
  attributeId String
  isRequired  Boolean    @default(false)
  isFilterable Boolean   @default(true)
  sortOrder   Int        @default(0)

  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute   Attribute  @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
  @@map("category_attributes")
}

model ProductAttributeValue {
  id              String         @id @default(cuid())
  productId       String?
  variantId       String?
  attributeId     String
  attributeValueId String

  product         Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute       Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue  AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId, attributeValueId])
  @@unique([variantId, attributeId, attributeValueId])
  @@index([productId])
  @@index([variantId])
  @@map("product_attribute_values")
}

model ProductMedia {
  id          String   @id @default(cuid())
  productId   String
  type        String   @default("image") // image, video, 3d, document
  url         String
  alt         String?
  title       String?
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  width       Int?
  height      Int?
  size        Int?     // bytes
  mimeType    String?
  cloudinaryId String?

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isPrimary])
  @@index([productId, sortOrder])
  @@map("product_media")
}

model ProductRelation {
  id            String   @id @default(cuid())
  productId     String
  relatedId     String
  type          String   @default("cross_sell") // cross_sell, up_sell, alternative, complement, recipe
  sortOrder     Int      @default(0)

  product       Product  @relation("ProductRelations", fields: [productId], references: [id], onDelete: Cascade)
  related       Product  @relation("ProductRelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId, type])
  @@index([productId])
  @@index([relatedId])
  @@map("product_relations")
}

// ============================================
// PRECIOS, PROMOCIONES, IMPUESTOS, DESCUENTOS
// ============================================

model PriceList {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  currency    String   @default("PEN")
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  priority    Int      @default(0)
  startDate   DateTime?
  endDate     DateTime?
  rules       Json?    // Reglas de precios dinámicos

  items       PriceListItem[]
  customers   CustomerPriceList[]

  @@index([slug])
  @@index([isActive, isDefault])
  @@map("price_lists")
}

model PriceListItem {
  id          String   @id @default(cuid())
  priceListId String
  productId   String?
  variantId   String?
  price       Decimal  @db.Decimal(12, 2)
  minQty      Int      @default(1)
  maxQty      Int?

  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId, variantId, minQty])
  @@index([priceListId])
  @@index([productId])
  @@index([variantId])
  @@map("price_list_items")
}

model CustomerPriceList {
  id          String    @id @default(cuid())
  customerId  String
  priceListId String

  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([customerId])
  @@map("customer_price_lists")
}

model Promotion {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?
  type            PromotionType
  value           Decimal        @db.Decimal(12, 2)
  minOrderAmount  Decimal?       @db.Decimal(12, 2)
  maxDiscount     Decimal?       @db.Decimal(12, 2)
  usageLimit      Int?
  usageCount      Int            @default(0)
  perCustomerLimit Int?
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean        @default(true)
  priority        Int            @default(0)
  appliesToAll    Boolean        @default(false)
  requiresCoupon  Boolean        @default(false)
  couponCode      String?        @unique
  conditions      Json?          // Condiciones complejas (categorías, productos, clientes, etc.)

  products        PromotionProduct[]
  coupons         Coupon[]

  @@index([slug])
  @@index([isActive, startDate, endDate])
  @@index([couponCode])
  @@map("promotions")
}

model PromotionProduct {
  id            String     @id @default(cuid())
  promotionId   String
  productId     String?
  variantId     String?
  categoryId    String?
  collectionId  String?

  promotion     Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product       Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  category      Category?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  collection    Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([productId])
  @@index([variantId])
  @@index([categoryId])
  @@map("promotion_products")
}

model Coupon {
  id              String      @id @default(cuid())
  code            String      @unique
  name            String
  description     String?
  type            CouponType
  value           Decimal     @db.Decimal(12, 2)
  minOrderAmount  Decimal?    @db.Decimal(12, 2)
  maxDiscount     Decimal?    @db.Decimal(12, 2)
  usageLimit      Int?
  usageCount      Int         @default(0)
  perCustomerLimit Int        @default(1)
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean     @default(true)
  appliesToAll    Boolean     @default(false)
  promotionId     String?

  products        CouponProduct[]
  customers       CouponCustomer[]
  orders          Order[]

  promotion       Promotion?  @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([isActive, startDate, endDate])
  @@map("coupons")
}

model CouponProduct {
  id        String   @id @default(cuid())
  couponId  String
  productId String?
  variantId String?
  categoryId String?

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([productId])
  @@index([variantId])
  @@map("coupon_products")
}

model CouponCustomer {
  id        String   @id @default(cuid())
  couponId  String
  customerId String

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([couponId, customerId])
  @@index([couponId])
  @@index([customerId])
  @@map("coupon_customers")
}

model TaxConfiguration {
  id          String   @id @default(cuid())
  name        String
  type        TaxType
  rate        Decimal  @db.Decimal(5, 4) // ej: 0.1800 para 18%
  isActive    Boolean  @default(true)
  appliesTo   String[] // Categorías, productos, o "all"
  exemptions  String[] // RUCs, tipos de cliente exentos
  startDate   DateTime
  endDate     DateTime?
  sunatCode   String?  // Código SUNAT para el impuesto

  @@index([type, isActive])
  @@map("tax_configurations")
}

// ============================================
// INVENTARIO, MOVIMIENTOS, LOTES, VENCIMIENTOS
// ============================================

model InventoryItem {
  id              String   @id @default(cuid())
  productId       String?  @unique
  variantId       String?  @unique
  quantity        Int      @default(0)
  reservedQty     Int      @default(0)
  availableQty    Int      @default(0)
  minStock        Int      @default(0)
  maxStock        Int?
  reorderPoint    Int      @default(0)
  reorderQty      Int      @default(0)
  location        String?  // Ubicación en almacén (ej: A-01-03)
  warehouseId     String?
  lastCountedAt   DateTime?
  lastMovementAt  DateTime?

  product         Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse       Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  lots            InventoryLot[]
  movements       StockMovement[]

  @@index([productId])
  @@index([variantId])
  @@index([warehouseId])
  @@index([quantity, minStock])
  @@map("inventory_items")
}

model Warehouse {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  city        String?
  region      String?
  country     String   @default("PE")
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  contactName String?
  contactPhone String?
  contactEmail String?

  inventory   InventoryItem[]
  shipments   Shipment[]

  @@index([code])
  @@index([isActive, isDefault])
  @@map("warehouses")
}

model InventoryLot {
  id              String   @id @default(cuid())
  productId       String
  variantId       String?
  lotNumber       String
  manufactureDate DateTime?
  expiryDate      DateTime?
  quantity        Int      @default(0)
  reservedQty     Int      @default(0)
  availableQty    Int      @default(0)
  costPrice       Decimal? @db.Decimal(12, 2)
  supplierId      String?
  purchaseOrderId String?
  status          LotStatus @default(ACTIVE)
  notes           String?

  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  supplier        Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  movements       StockMovement[]

  @@unique([productId, lotNumber])
  @@index([variantId])
  @@index([expiryDate, status])
  @@index([supplierId])
  @@map("inventory_lots")
}

model StockMovement {
  id              String              @id @default(cuid())
  productId       String
  variantId       String?
  lotId           String?
  type            InventoryMovementType
  quantity        Int                 // Positivo = entrada, Negativo = salida
  previousQty     Int
  newQty          Int
  unitCost        Decimal?            @db.Decimal(12, 2)
  totalCost       Decimal?            @db.Decimal(12, 2)
  referenceType   String?             // order, purchase_order, adjustment, transfer, etc.
  referenceId     String?
  warehouseId     String?
  fromWarehouseId String?
  toWarehouseId   String?
  notes           String?
  performedBy     String
  approvedBy      String?
  createdAt       DateTime            @default(now())

  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  lot             InventoryLot?     @relation(fields: [lotId], references: [id], onDelete: SetNull)
  warehouse       Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  fromWarehouse   Warehouse?        @relation("FromWarehouseMovements", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouse     Warehouse?        @relation("ToWarehouseMovements", fields: [toWarehouseId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([lotId])
  @@index([referenceType, referenceId])
  @@index([warehouseId, createdAt])
  @@index([type, createdAt])
  @@map("stock_movements")
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  ruc         String?  @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  region      String?
  country     String   @default("PE")
  paymentTerms Int     @default(30) // días
  currency    String   @default("PEN")
  isActive    Boolean  @default(true)
  rating      Int      @default(0) // 1-5
  notes       String?

  purchaseOrders PurchaseOrder[]
  lots           InventoryLot[]

  @@index([slug])
  @@index([ruc])
  @@index([isActive])
  @@map("suppliers")
}

model PurchaseOrder {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  supplierId      String
  warehouseId     String
  status          String   @default("DRAFT") // DRAFT, SENT, CONFIRMED, PARTIAL, RECEIVED, CANCELLED
  orderDate       DateTime @default(now())
  expectedDate    DateTime?
  receivedDate    DateTime?
  subtotal        Decimal  @db.Decimal(12, 2)
  taxAmount       Decimal  @db.Decimal(12, 2)
  total           Decimal  @db.Decimal(12, 2)
  currency        String   @default("PEN")
  exchangeRate    Decimal  @default(1.0) @db.Decimal(10, 4)
  notes           String?
  createdBy       String
  approvedBy      String?
  approvedAt      DateTime?

  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items           PurchaseOrderItem[]
  lots            InventoryLot[]

  @@index([orderNumber])
  @@index([supplierId, status])
  @@index([warehouseId, status])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String
  variantId       String?
  quantity        Int
  receivedQty     Int      @default(0)
  unitPrice       Decimal  @db.Decimal(12, 2)
  taxRate         Decimal  @default(18.00) @db.Decimal(5, 2)
  total           Decimal  @db.Decimal(12, 2)
  notes           String?

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

// ============================================
// CARRITOS, PEDIDOS, PAGOS, DEVOLUCIONES
// ============================================

model Cart {
  id          String   @id @default(cuid())
  userId      String?  @unique
  sessionId   String?  @unique
  currency    String   @default("PEN")
  expiresAt   DateTime @default(dbgenerated("(now() + interval '30 days')"))
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]
  appliedCoupons CartCoupon[]

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(12, 2) // Precio congelado al agregar
  metadata  Json?    // Opciones personalizadas, regalo, etc.

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model CartCoupon {
  id        String   @id @default(cuid())
  cartId    String
  couponId  String
  appliedAt DateTime @default(now())

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([cartId, couponId])
  @@map("cart_coupons")
}

model Order {
  id                  String       @id @default(cuid())
  orderNumber         String       @unique
  userId              String?
  guestEmail          String?
  guestToken          String?      @unique // Para tracking sin cuenta
  status              OrderStatus  @default(PENDING_PAYMENT)
  currency            String       @default("PEN")
  subtotal            Decimal      @db.Decimal(12, 2)
  discountAmount      Decimal      @default(0) @db.Decimal(12, 2)
  shippingAmount      Decimal      @default(0) @db.Decimal(12, 2)
  taxAmount           Decimal      @default(0) @db.Decimal(12, 2)
  total               Decimal      @db.Decimal(12, 2)
  paidAmount          Decimal      @default(0) @db.Decimal(12, 2)
  balanceDue          Decimal      @default(0) @db.Decimal(12, 2)

  // Direcciones
  shippingAddressId   String?
  billingAddressId    String?
  shippingAddress     Json?        // Snapshot de la dirección
  billingAddress      Json?

  // Envío
  shippingMethod      String?
  shippingCarrier     String?
  shippingTracking    String?
  shippingTrackingUrl String?
  estimatedDelivery   DateTime?

  // Pago
  paymentMethod       PaymentMethod?
  paymentReference    String?
  paymentIdempotencyKey String?    @unique

  // Facturación
  documentType        DocumentType?
  documentSeries      String?
  documentNumber      String?
  documentSunatStatus String?
  documentSunatResponse Json?

  // Notas
  customerNotes       String?
  internalNotes       String?
  giftMessage         String?
  isGift              Boolean      @default(false)

  // Fechas
  createdAt           DateTime    @default(now())
  confirmedAt         DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  cancelledReason     String?

  // Relaciones
  user                User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingAddressRel  Address?     @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddressRel   Address?     @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]
  refunds             Refund[]
  statusHistory       OrderStatusHistory[]
  shipments           Shipment[]
  appliedCoupons      OrderCoupon[]
  promotions          OrderPromotion[]
  documents           Document[]
  auditLogs           AuditLog[]

  @@index([orderNumber])
  @@index([userId, status])
  @@index([guestToken])
  @@index([status, createdAt])
  @@index([paymentIdempotencyKey])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  sku             String
  name            String
  variantName     String?
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(12, 2)
  taxRate         Decimal  @db.Decimal(5, 2)
  taxAmount       Decimal  @db.Decimal(12, 2)
  total           Decimal  @db.Decimal(12, 2)
  metadata        Json?    // Opciones, personalización, lote, etc.

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  reason      String?
  metadata    Json?
  createdBy   String?
  createdAt   DateTime    @default(now())

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderCoupon {
  id        String   @id @default(cuid())
  orderId   String
  couponId  String
  discount  Decimal  @db.Decimal(12, 2)

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([orderId, couponId])
  @@map("order_coupons")
}

model OrderPromotion {
  id            String   @id @default(cuid())
  orderId       String
  promotionId   String
  discount      Decimal  @db.Decimal(12, 2)

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion     Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([orderId, promotionId])
  @@map("order_promotions")
}

model Payment {
  id                  String        @id @default(cuid())
  orderId             String
  paymentMethod       PaymentMethod
  provider            String        // mercadopago, yape, plin, manual, etc.
  providerPaymentId   String?       @unique
  providerOrderId     String?
  status              PaymentStatus @default(PENDING)
  amount              Decimal       @db.Decimal(12, 2)
  currency            String        @default("PEN")
  feeAmount           Decimal       @default(0) @db.Decimal(12, 2)
  netAmount           Decimal       @db.Decimal(12, 2)
  idempotencyKey      String?       @unique
  payerEmail          String?
  payerPhone          String?
  payerDocument       String?       // DNI/RUC
  payerName           String?
  paymentDetails      Json?         // Respuesta completa del proveedor
  refundedAmount      Decimal       @default(0) @db.Decimal(12, 2)
  createdAt           DateTime      @default(now())
  processedAt         DateTime?
  confirmedAt         DateTime?
  failedAt            DateTime?
  failureReason       String?
  metadata            Json?

  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events              PaymentEvent[]
  refunds             Refund[]

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([status, createdAt])
  @@index([idempotencyKey])
  @@map("payments")
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String
  eventType       String   // payment.created, payment.approved, payment.rejected, etc.
  providerEventId String?  @unique
  payload         Json
  processed       Boolean  @default(false)
  processedAt     DateTime?
  error           String?
  createdAt       DateTime @default(now())

  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([providerEventId])
  @@index([eventType, processed])
  @@map("payment_events")
}

model Refund {
  id              String   @id @default(cuid())
  orderId         String
  paymentId       String?
  amount          Decimal  @db.Decimal(12, 2)
  reason          String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, PROCESSED, FAILED
  providerRefundId String? @unique
  processedBy     String?
  processedAt     DateTime?
  notes           String?
  metadata        Json?
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment         Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  items           RefundItem[]

  @@index([orderId])
  @@index([paymentId])
  @@index([status, createdAt])
  @@map("refunds")
}

model RefundItem {
  id        String     @id @default(cuid())
  refundId  String
  orderItemId String
  quantity  Int
  amount    Decimal    @db.Decimal(12, 2)
  reason    String?

  refund    Refund     @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([refundId, orderItemId])
  @@map("refund_items")
}

// ============================================
// CLIENTES, DIRECCIONES, COMUNICACIONES
// ============================================

model Customer {
  id              String   @id @default(cuid())
  userId          String?  @unique
  documentType    String?  // DNI, RUC, CE, PASAPORTE
  documentNumber  String?  @unique
  firstName       String
  lastName        String
  businessName    String?  // Para RUC
  email           String
  phone           String?
  birthDate       DateTime?
  gender          String?
  isWholesale     Boolean  @default(false)
  wholesaleTier   String?  // Nivel de precio mayorista
  creditLimit     Decimal? @db.Decimal(12, 2)
  creditUsed      Decimal  @default(0) @db.Decimal(12, 2)
  notes           String?
  tags            String[]
  marketingConsent Boolean @default(false)
  marketingConsentAt DateTime?

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses       Address[]
  orders          Order[]
  priceList       CustomerPriceList?
  coupons         CouponCustomer[]
  wishlist        Wishlist[]
  reviews         Review[]
  notifications   Notification[]
  communications  Communication[]
  qrScans         QrScan[]

  @@index([userId])
  @@index([documentNumber])
  @@index([email])
  @@index([isWholesale])
  @@map("customers")
}

model Address {
  id            String   @id @default(cuid())
  userId        String?
  customerId    String?
  type          String   @default("shipping") // shipping, billing, both
  isDefault     Boolean  @default(false)
  firstName     String
  lastName      String
  company       String?
  addressLine1  String
  addressLine2  String?
  neighborhood  String?  // Urbanización
  district      String   // Distrito
  province      String   // Provincia
  department    String   // Departamento
  postalCode    String?
  country       String   @default("PE")
  phone         String?
  instructions  String?  // Referencias, portería, etc.
  latitude      Decimal? @db.Decimal(10, 8)
  longitude     Decimal? @db.Decimal(11, 8)
  ubigeo        String?  // Código UBIGEO INEI

  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ordersShipping Order[]  @relation("OrderShippingAddress")
  ordersBilling  Order[]  @relation("OrderBillingAddress")
  shipments     Shipment[]

  @@index([userId])
  @@index([customerId])
  @@index([district, province, department])
  @@map("addresses")
}

model Communication {
  id          String   @id @default(cuid())
  customerId  String
  type        String   // email, sms, whatsapp, push, in_app
  subject     String?
  content     String
  templateId  String?
  status      String   @default("PENDING") // PENDING, SENT, DELIVERED, FAILED, OPENED, CLICKED
  provider    String?
  providerId  String?
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  error       String?
  metadata    Json?
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([status, type])
  @@map("communications")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  customerId  String?
  type        NotificationType
  channel     NotificationChannel
  title       String
  message     String
  data        Json?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  sentAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([customerId, createdAt])
  @@index([type, createdAt])
  @@map("notifications")
}

// ============================================
// LOGÍSTICA, TRANSPORTISTAS, SEGUIMIENTO
// ============================================

model Carrier {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  code            String   @unique // Para API
  type            String   @default("courier") // courier, postal, pickup, own
  apiEndpoint     String?
  apiKey          String?
  apiSecret       String?
  trackingUrl     String?
  supportsPickup  Boolean  @default(false)
  supportsDropoff Boolean  @default(false)
  maxWeight       Decimal? @db.Decimal(8, 3)
  maxDimensions   Json?    // {length, width, height}
  isActive        Boolean  @default(true)
  config          Json?    // Configuración específica del transportista
  priority        Int      @default(0)

  shipments       Shipment[]
  shippingZones   ShippingZone[]

  @@index([slug])
  @@index([code])
  @@index([isActive])
  @@map("carriers")
}

model ShippingZone {
  id          String   @id @default(cuid())
  name        String
  carrierId   String
  countries   String[] @default(["PE"])
  regions     String[] // Departamentos
  provinces   String[] // Provincias
  districts   String[] // Distritos
  postalCodes String[] // Códigos postales
  isActive    Boolean  @default(true)

  carrier     Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  rates       ShippingRate[]

  @@index([carrierId])
  @@map("shipping_zones")
}

model ShippingRate {
  id              String   @id @default(cuid())
  zoneId          String
  name            String
  minWeight       Decimal  @default(0) @db.Decimal(8, 3)
  maxWeight       Decimal? @db.Decimal(8, 3)
  minOrderAmount  Decimal? @db.Decimal(12, 2)
  maxOrderAmount  Decimal? @db.Decimal(12, 2)
  basePrice       Decimal  @db.Decimal(12, 2)
  pricePerKg      Decimal  @default(0) @db.Decimal(12, 2)
  pricePerKm      Decimal  @default(0) @db.Decimal(12, 2)
  estimatedDays   Int
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)

  zone            ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@index([isActive])
  @@map("shipping_rates")
}

model ShippingRule {
  id              String   @id @default(cuid())
  productId       String?
  variantId       String?
  categoryId      String?
  carrierId       String?
  zoneId          String?
  freeShipping    Boolean  @default(false)
  fixedPrice      Decimal? @db.Decimal(12, 2)
  multiplier      Decimal  @default(1.0) @db.Decimal(3, 2)
  minQty          Int      @default(1)
  maxQty          Int?
  isActive        Boolean  @default(true)
  priority        Int      @default(0)

  product         Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  carrier         Carrier?     @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  zone            ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([categoryId])
  @@index([carrierId])
  @@map("shipping_rules")
}

model Shipment {
  id              String         @id @default(cuid())
  shipmentNumber  String         @unique
  orderId         String
  carrierId       String
  warehouseId     String?
  addressId       String?
  status          ShipmentStatus @default(PENDING)
  trackingNumber  String?        @unique
  trackingUrl     String?
  labelUrl        String?
  labelFormat     String?        // PDF, ZPL, PNG
  weight          Decimal?       @db.Decimal(8, 3)
  dimensions      Json?          // {length, width, height}
  declaredValue   Decimal?       @db.Decimal(12, 2)
  shippingCost    Decimal        @db.Decimal(12, 2)
  insuranceCost   Decimal        @default(0) @db.Decimal(12, 2)
  codAmount       Decimal?       @db.Decimal(12, 2) // Contraentrega
  pickupDate      DateTime?
  shippedAt       DateTime?
  estimatedDelivery DateTime?
  deliveredAt     DateTime?
  failedAttempts  Int            @default(0)
  failureReason   String?
  notes           String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier         Carrier        @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  warehouse       Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  address         Address?       @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items           ShipmentItem[]
  events          TrackingEvent[]

  @@index([shipmentNumber])
  @@index([orderId])
  @@index([carrierId, status])
  @@index([trackingNumber])
  @@index([status, createdAt])
  @@map("shipments")
}

model ShipmentItem {
  id          String   @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Int
  lotId       String?

  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  lot         InventoryLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@unique([shipmentId, orderItemId])
  @@index([shipmentId])
  @@map("shipment_items")
}

model TrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  location    String?
  description String
  eventDate   DateTime
  providerRaw Json?
  isManual    Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())

  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, eventDate])
  @@index([status, eventDate])
  @@map("tracking_events")
}

// ============================================
// FACTURACIÓN, RECIBOS, CONTABILIDAD
// ============================================

model Document {
  id              String        @id @default(cuid())
  orderId         String
  type            DocumentType
  series          String
  number          Int
  sunatId         String?       @unique // UUID SUNAT
  sunatStatus     String?       // ACEPTADO, RECHAZADO, ANULADO, PENDIENTE
  sunatResponse   Json?
  xmlContent      String?       @db.Text
  cdrContent      String?       @db.Text
  pdfUrl          String?
  createdAt       DateTime     @default(now())
  signedAt        DateTime?
  sentAt          DateTime?
  voidedAt        DateTime?
  voidReason      String?
  metadata        Json?

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  accountingEntries AccountingEntry[]

  @@unique([type, series, number])
  @@index([orderId])
  @@index([sunatId])
  @@index([sunatStatus, createdAt])
  @@map("documents")
}

model AccountingEntry {
  id              String              @id @default(cuid())
  entryNumber     String              @unique
  date            DateTime
  type            AccountingEntryType
  description     String
  referenceType   String?             // document, payment, refund, adjustment, etc.
  referenceId     String?
  totalDebit      Decimal             @db.Decimal(14, 2)
  totalCredit     Decimal             @db.Decimal(14, 2)
  status          String              @default("DRAFT") // DRAFT, POSTED, VOIDED
  postedBy        String?
  postedAt        DateTime?
  voidedBy        String?
  voidedAt        DateTime?
  voidReason      String?
  metadata        Json?
  createdBy       String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  lines           AccountingEntryLine[]
  documents       Document[]

  @@index([date, status])
  @@index([type, date])
  @@index([referenceType, referenceId])
  @@map("accounting_entries")
}

model AccountingEntryLine {
  id              String   @id @default(cuid())
  entryId         String
  accountId       String
  description     String?
  debit           Decimal  @default(0) @db.Decimal(14, 2)
  credit          Decimal  @default(0) @db.Decimal(14, 2)
  costCenterId    String?
  projectId       String?
  sortOrder       Int      @default(0)

  entry           AccountingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account         Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([accountId])
  @@map("accounting_entry_lines")
}

model Account {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        String   // asset, liability, equity, income, expense
  subtype     String?  // current, fixed, bank, receivable, payable, tax, etc.
  parentId    String?
  level       Int      @default(0)
  currency    String   @default("PEN")
  isActive    Boolean  @default(true)
  allowPosting Boolean @default(true)
  description String?

  parent      Account?   @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Account[]  @relation("AccountHierarchy")
  lines       AccountingEntryLine[]

  @@index([code])
  @@index([parentId])
  @@index([type, isActive])
  @@map("accounts")
}

model CashMovement {
  id              String           @id @default(cuid())
  movementNumber  String           @unique
  date            DateTime
  type            CashMovementType
  amount          Decimal          @db.Decimal(12, 2)
  currency        String           @default("PEN")
  paymentMethod   PaymentMethod?
  referenceType   String?          // order, payment, refund, expense, transfer, etc.
  referenceId     String?
  description     String
  status          String           @default("POSTED") // POSTED, VOIDED
  voidedBy        String?
  voidedAt        DateTime?
  voidReason      String?
  performedBy     String
  approvedBy      String?
  approvedAt      DateTime?
  metadata        Json?
  createdAt       DateTime         @default(now())

  user            User             @relation(fields: [performedBy], references: [id], onDelete: Cascade)

  @@index([date, type])
  @@index([referenceType, referenceId])
  @@index([status, date])
  @@map("cash_movements")
}

model Expense {
  id              String   @id @default(cuid())
  expenseNumber   String   @unique
  date            DateTime
  category        String   // rent, utilities, marketing, payroll, supplies, etc.
  subcategory     String?
  supplierId      String?
  amount          Decimal  @db.Decimal(12, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(12, 2)
  total           Decimal  @db.Decimal(12, 2)
  currency        String   @default("PEN")
  paymentMethod   PaymentMethod?
  paidAt          DateTime?
  status          String   @default("PENDING") // PENDING, APPROVED, PAID, REJECTED, CANCELLED
  description     String?
  receiptUrl      String?
  approvedBy      String?
  approvedAt      DateTime?
  paidBy          String?
  metadata        Json?
  createdBy       String
  createdAt       DateTime @default(now())

  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([date, status])
  @@index([category, date])
  @@index([supplierId])
  @@map("expenses")
}

// ============================================
// ETIQUETAS, CÓDIGOS DE BARRAS, QR
// ============================================

model QrCode {
  id          String   @id @default(cuid())
  code        String   @unique // El contenido del QR (URL, texto, etc.)
  type        String   // product, recipe, collection, order, tracking, custom
  referenceId String?  // ID del producto, receta, etc.
  title       String?
  description String?
  imageUrl    String?  // URL en Cloudinary
  scanCount   Int      @default(0)
  lastScannedAt DateTime?
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  metadata    Json?
  createdBy   String
  createdAt   DateTime @default(now())

  product     Product? @relation(fields: [referenceId], references: [id], onDelete: SetNull)
  recipe      Recipe?  @relation(fields: [referenceId], references: [id], onDelete: SetNull)
  scans       QrScan[]

  @@index([type, referenceId])
  @@index([code])
  @@index([isActive, expiresAt])
  @@map("qr_codes")
}

model QrScan {
  id          String   @id @default(cuid())
  qrCodeId    String
  customerId  String?
  ipAddress   String?
  userAgent   String?
  location    Json?    // {lat, lng, city, country} si está disponible
  referrer    String?
  scannedAt   DateTime @default(now())

  qrCode      QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([qrCodeId, scannedAt])
  @@index([customerId, scannedAt])
  @@map("qr_scans")
}

model LabelTemplate {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique // SKU, EAN13, CUSTOM, etc.
  type        String   // product, lot, shipping, shelf, custom
  format      String   @default("PDF") // PDF, SVG, ZPL, PNG
  pageSize    String   @default("A4") // A4, 50x30mm, 60x40mm, 100x150mm, custom
  customWidth Decimal? @db.Decimal(6, 2)
  customHeight Decimal? @db.Decimal(6, 2)
  margins     Json?    // {top, right, bottom, left} en mm
  columns     Int      @default(1)
  rows        Int      @default(1)
  gapX        Decimal  @default(0) @db.Decimal(4, 2)
  gapY        Decimal  @default(0) @db.Decimal(4, 2)
  template    Json     // Estructura del template (campos, posiciones, fuentes, etc.)
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  labels      PrintedLabel[]

  @@index([code, type])
  @@index([isActive, isDefault])
  @@map("label_templates")
}

model PrintedLabel {
  id              String   @id @default(cuid())
  templateId      String
  productId       String?
  variantId       String?
  lotId           String?
  qrCodeId        String?
  quantity        Int      @default(1)
  status          String   @default("PENDING") // PENDING, PRINTED, REPRINTED, VOIDED
  pdfUrl          String?
  printedAt       DateTime?
  printedBy       String?
  printerName     String?
  notes           String?
  createdBy       String
  createdAt       DateTime @default(now())

  template        LabelTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product         Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  lot             InventoryLot?  @relation(fields: [lotId], references: [id], onDelete: SetNull)
  qrCode          QrCode?        @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  @@index([templateId, createdAt])
  @@index([productId, createdAt])
  @@index([lotId])
  @@index([status, createdAt])
  @@map("printed_labels")
}

// ============================================
// RECETAS INTERACTIVAS
// ============================================

model Recipe {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  subtitle        String?
  description     String?
  story           String?  @db.Text // Historia del plato
  difficulty      String   @default("FÁCIL") // FÁCIL, MEDIO, DIFÍCIL
  prepTime        Int      @default(0) // minutos
  cookTime        Int      @default(0) // minutos
  restTime        Int      @default(0) // minutos
  totalTime       Int      @default(0) // calculado
  servings        Int      @default(4)
  baseServings    Int      @default(4) // Para recálculo
  image           String?
  videoUrl        String?
  cuisineType     String?  // Peruana, Criolla, Marina, Andina, Amazónica, Fusión, Internacional
  mealType        String[] // DESAYUNO, ALMUERZO, CENA, ENTRADA, POSTRE, BEBIDA, SNACK
  occasion        String[] // NAVIDAD, FIESTAS PATRIAS, DÍA DE LA MADRE, CUMPLEAÑOS, DÍA A DÍA, CENA ROMÁNTICA
  tags            String[]
  nutritionInfo   Json?    // {calories, protein, carbs, fat, fiber, sugar, sodium} por porción
  tips            String[] @db.Text
  warnings        String[] // Alérgenos, picante, etc.
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String[]
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  featuredUntil   DateTime?
  viewCount       Int      @default(0)
  rating          Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount     Int      @default(0)
  authorId        String

  // Relaciones
  author          User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ingredients     RecipeIngredient[]
  products        RecipeProduct[]
  steps           RecipeStep[]
  collections     RecipeCollectionRecipe[]
  ratings         RecipeRating[]
  qrCodes         QrCode[]
  pdfDownloads    RecipePdfDownload[]

  @@index([slug])
  @@index([isPublished, publishedAt])
  @@index([authorId])
  @@index([cuisineType])
  @@index([mealType])
  @@index([occasion])
  @@index([difficulty])
  @@map("recipes")
}

model RecipeIngredient {
  id              String   @id @default(cuid())
  recipeId        String
  productId       String?
  variantId       String?
  name            String   // Nombre si no hay producto vinculado
  quantity        Decimal  @db.Decimal(10, 3)
  unit            String   // g, kg, ml, l, unidad, cda, cta, pizca, taza
  originalQuantity Decimal @db.Decimal(10, 3) // Para recálculo
  originalUnit    String
  isOptional      Boolean  @default(false)
  notes           String?  // "picado finamente", "a temperatura ambiente"
  sortOrder       Int      @default(0)
  groupName       String?  // "Para la masa", "Para el relleno"

  recipe          Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([recipeId, sortOrder])
  @@index([productId])
  @@map("recipe_ingredients")
}

model RecipeProduct {
  id          String   @id @default(cuid())
  recipeId    String
  productId   String
  variantId   String?
  quantity    Int      @default(1)
  isRequired  Boolean  @default(true)
  sortOrder   Int      @default(0)
  notes       String?

  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([recipeId, productId, variantId])
  @@index([recipeId])
  @@index([productId])
  @@map("recipe_products")
}

model RecipeStep {
  id          String   @id @default(cuid())
  recipeId    String
  stepNumber  Int
  title       String?
  description String   @db.Text
  image       String?
  videoUrl    String?
  duration    Int?     // minutos
  temperature String?  // "180°C", "fuego medio"
  tips        String[]
  sortOrder   Int      @default(0)

  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, stepNumber])
  @@index([recipeId, sortOrder])
  @@map("recipe_steps")
}

model RecipeCollection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  recipes     RecipeCollectionRecipe[]

  @@index([slug])
  @@index([isActive])
  @@map("recipe_collections")
}

model RecipeCollectionRecipe {
  id              String   @id @default(cuid())
  collectionId    String
  recipeId        String
  sortOrder       Int      @default(0)

  collection      RecipeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recipe          Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([collectionId, recipeId])
  @@index([collectionId])
  @@index([recipeId])
  @@map("recipe_collection_recipes")
}

model RecipeRating {
  id          String   @id @default(cuid())
  recipeId    String
  userId      String
  rating      Int      // 1-5
  comment     String?
  isVerified  Boolean  @default(false) // Compra verificada
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
  @@index([recipeId, rating])
  @@map("recipe_ratings")
}

model RecipePdfDownload {
  id          String   @id @default(cuid())
  recipeId    String
  userId      String?
  customerId  String?
  ipAddress   String?
  userAgent   String?
  downloadedAt DateTime @default(now())

  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([recipeId, downloadedAt])
  @@map("recipe_pdf_downloads")
}

// ============================================
// CMS: BANNERS, PÁGINAS, MENÚS, SEO, REDES
// ============================================

model Banner {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  title       String?
  subtitle    String?
  description String?
  image       String
  mobileImage String?
  linkUrl     String?
  linkText    String?
  position    String   // hero, category, product, footer, sidebar, popup
  targetPage  String?  // home, catalog, collection, product, custom
  targetId    String?  // ID de colección, categoría, producto
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  openInNewTab Boolean @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([position, isActive, startDate, endDate])
  @@index([targetPage, targetId])
  @@map("banners")
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String   @db.Text // HTML/Markdown/JSON del editor
  excerpt         String?
  template        String   @default("default") // default, landing, legal, contact, FAQ, about
  status          String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  isSystem        Boolean  @default(false) // Páginas legales, contacto, etc.
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String[]
  canonicalUrl    String?
  ogImage         String?
  ogType          String   @default("website")
  publishedAt     DateTime?
  publishedBy     String?
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
  @@index([template, isSystem])
  @@map("pages")
}

model Menu {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  location    String   // header, footer, mobile, sidebar, account
  isActive    Boolean  @default(true)
  items       MenuItem[]

  @@index([slug, location])
  @@index([location, isActive])
  @@map("menus")
}

model MenuItem {
  id          String   @id @default(cuid())
  menuId      String
  parentId    String?
  label       String
  url         String?
  targetPage  String?  // home, catalog, category, collection, product, page, custom
  targetId    String?
  icon        String?
  badge       String?
  badgeColor  String?
  openInNewTab Boolean @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  roles       String[] // Roles que pueden ver este item
  metadata    Json?

  menu        Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent      MenuItem? @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    MenuItem[] @relation("MenuHierarchy")

  @@index([menuId, parentId, sortOrder])
  @@map("menu_items")
}

model SocialLink {
  id          String   @id @default(cuid())
  platform    String   // facebook, instagram, tiktok, whatsapp, youtube, twitter, linkedin, pinterest
  name        String
  url         String
  handle      String?
  icon        String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  metadata    Json?

  @@unique([platform])
  @@index([isActive, sortOrder])
  @@map("social_links")
}

model SEOConfig {
  id              String   @id @default(cuid())
  pageType        String   @unique // home, catalog, category, product, collection, recipe, cart, checkout, account, search, 404
  titleTemplate   String
  descriptionTemplate String
  keywords        String[]
  ogImage         String?
  twitterCard     String   @default("summary_large_image")
  robots          String   @default("index, follow")
  canonical       Boolean  @default(true)
  structuredData  Json?    // JSON-LD templates
  customHead      String?  @db.Text
  customBody      String?  @db.Text
  updatedAt       DateTime @updatedAt

  @@map("seo_configs")
}

// ============================================
// WISHLIST, RESEÑAS, FAVORITOS
// ============================================

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  variantId String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@index([productId])
  @@map("wishlists")
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  customerId  String?
  orderItemId String?
  rating      Int      // 1-5
  title       String?
  content     String?
  pros        String?
  cons        String?
  images      String[]
  isVerified  Boolean  @default(false)
  isApproved  Boolean  @default(false)
  helpful     Int      @default(0)
  reported    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([productId, isApproved])
  @@index([customerId])
  @@index([rating])
  @@map("reviews")
}

// ============================================
// AUDITORÍA, CONFIGURACIÓN, WEBHOOKS
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  customerId  String?
  action      String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, PAYMENT, SHIPMENT, etc.
  entityType  String   // Product, Order, User, Payment, etc.
  entityId    String
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([customerId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model StoreSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  type        String   // string, number, boolean, json, array, color, image, html
  group       String   // general, branding, checkout, shipping, payment, tax, email, sms, seo, legal
  label       String
  description String?
  isPublic    Boolean  @default(false) // Visible en frontend
  isEditable  Boolean  @default(true)
  sortOrder   Int      @default(0)
  validation  Json?    // Reglas de validación
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([group, sortOrder])
  @@index([isPublic])
  @@map("store_settings")
}

model WebhookEvent {
  id              String           @id @default(cuid())
  eventType       WebhookEventType
  provider        String           // mercadopago, shalom, sunat, cloudinary, neon, etc.
  providerEventId String           @unique
  payload         Json
  headers         Json?
  status          String           @default("PENDING") // PENDING, PROCESSING, PROCESSED, FAILED, IGNORED
  attempts        Int              @default(0)
  maxAttempts     Int              @default(5)
  lastAttemptAt   DateTime?
  nextAttemptAt   DateTime?
  error           String?
  processedAt     DateTime?
  createdAt       DateTime         @default(now())

  @@index([provider, providerEventId])
  @@index([eventType, status])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@map("webhook_events")
}

// ============================================
// BUNDLES / PACKS GOURMET
// ============================================

model BundleItem {
  id              String   @id @default(cuid())
  bundleId        String   // Product ID del bundle (type = BUNDLE)
  componentId     String   // Product ID del componente
  componentVariantId String?
  quantity        Int      @default(1)
  isOptional      Boolean  @default(false)
  sortOrder       Int      @default(0)

  bundle          Product  @relation("BundleProducts", fields: [bundleId], references: [id], onDelete: Cascade)
  component       Product  @relation("BundleComponents", fields: [componentId], references: [id], onDelete: Cascade)
  componentVariant ProductVariant? @relation(fields: [componentVariantId], references: [id], onDelete: SetNull)

  @@unique([bundleId, componentId, componentVariantId])
  @@index([bundleId])
  @@index([componentId])
  @@map("bundle_items")
}

// ============================================
// GIFT CARDS
// ============================================

model GiftCard {
  id              String   @id @default(cuid())
  code            String   @unique
  templateId      String?
  initialBalance  Decimal  @db.Decimal(12, 2)
  currentBalance  Decimal  @db.Decimal(12, 2)
  currency        String   @default("PEN")
  status          String   @default("ACTIVE") // ACTIVE, REDEEMED, EXPIRED, CANCELLED
  purchaserId     String?
  recipientEmail  String?
  recipientName   String?
  message         String?
  expiresAt       DateTime?
  redeemedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code])
  @@index([purchaserId])
  @@index([status, expiresAt])
  @@map("gift_cards")
}

model GiftCardTransaction {
  id          String   @id @default(cuid())
  giftCardId  String
  type        String   // PURCHASE, REDEEM, REFUND, EXPIRE
  amount      Decimal  @db.Decimal(12, 2)
  balance     Decimal  @db.Decimal(12, 2)
  orderId     String?
  notes       String?
  createdAt   DateTime @default(now())

  giftCard    GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId, createdAt])
  @@map("gift_card_transactions")
}

// ============================================
// LIBRO DE RECLAMACIONES (INDECOPI)
// ============================================

model ComplaintBookEntry {
  id              String   @id @default(cuid())
  entryNumber     String   @unique // Formato: R-YYYY-NNNNNN
  documentType    String   // DNI, RUC, CE, PASAPORTE
  documentNumber  String
  firstName       String
  lastName        String
  email           String
  phone           String?
  address         String?
  district        String?
  province        String?
  department      String?
  type            String   // RECLAMO, QUEJA
  subject         String
  detail          String   @db.Text
  requestedAmount Decimal? @db.Decimal(12, 2)
  attachmentUrls  String[]
  status          String   @default("REGISTRADO") // REGISTRADO, EN_TRAMITE, RESUELTO, ARCHIVADO, RECHAZADO
  response        String?  @db.Text
  respondedAt     DateTime?
  respondedBy     String?
  resolutionCode  String?  // Código de resolución INDECOPI
  followUpRequired Boolean @default(false)
  followUpDate    DateTime?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([entryNumber])
  @@index([documentNumber, status])
  @@index([status, createdAt])
  @@index([type, status])
  @@map("complaint_book_entries")
}